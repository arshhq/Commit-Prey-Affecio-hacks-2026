# Demo mode works with no secrets. Fill these only if you want real backends.

# --- Expo app (client-safe / public) ---
# Supabase Auth (optional). Without these, email sign-in falls back to demo session.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional Message Guard proxy URL (POST { "text": "..." } → SafetyAnalysis JSON).
# Point at the local secure proxy (prefer 127.0.0.1 over localhost for IPv4):
#   http://127.0.0.1:8787/analyze-message
# Never put Gemini / Anthropic / OpenAI API keys in the mobile app.
EXPO_PUBLIC_AI_PROXY_URL=

# --- Server only (server/analyze-message.mjs) — do NOT prefix with EXPO_PUBLIC ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# ANALYZE_PORT=8787

# --- Archived Next.js web/ (optional) ---
# ANTHROPIC_API_KEY=
